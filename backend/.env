# ---- Web server ----
PORT=3000

# ---- MongoDB (Atlas cluster, not local) ----
# MONGO_URI is set directly, so it overrides the MONGO_HOST/PORT/USER/
# PASSWORD pieces below (config/db.js prefers MONGO_URI when present).
# Note the database name "security_guard_db" was added into the path -
# the original connection string didn't specify one.
MONGO_URI=mongodb+srv://kumarnanda032_db_user:eTv61xDxwBlgLWK0@cluster0.gclmt8h.mongodb.net/security_guard_db?appName=Cluster0

# Unused while MONGO_URI is set above - kept here in case you switch back
# to a local MongoDB instance later.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=security_guard_db
MONGO_USER=
MONGO_PASSWORD=
