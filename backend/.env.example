# Copy this file to `.env` and adjust the values for your machine.

# ---- Web server ----
PORT=3000

# ---- MongoDB ----
# Option A: local instance, built from these pieces by config/db.js.
# See README.md -> "Securing local MongoDB with an admin user" for how to
# create this user in MongoDB itself. Leave MONGO_USER/MONGO_PASSWORD
# blank to connect without credentials.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=security_guard_db
MONGO_USER=asg_admin
MONGO_PASSWORD=ChangeThisPassword123
MONGO_AUTH_SOURCE=admin

# Option B: set MONGO_URI directly - this always takes priority over the
# MONGO_* pieces above when present. Use this for MongoDB Atlas (cloud)
# or when your password has characters that need URI-encoding.
# Local example:
# MONGO_URI=mongodb://asg_admin:ChangeThisPassword123@127.0.0.1:27017/security_guard_db?authSource=admin
# Atlas example (get this from Atlas -> Connect -> Drivers, then add
# your database name into the path before the "?"):
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/security_guard_db?appName=Cluster0

# ---- Forgot password: OTP by SMS (routes/passwordReset.js) ----
# Credentials for the SMS provider. Required for /send-otp to text anything.
# Keep the real values only in your private .env - never commit them.
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=ADIUNV
# SMS_API_URL=https://pgapi.vispl.in/fe/api/v1/multiSend
# Message wording - {name} and {otp} are filled in. If your SMS provider only
# delivers DLT-approved templates, this must match an approved one exactly.
# SMS_OTP_TEMPLATE=Dear {name}, Your OTP to reset the password of Technical Hub app is {otp}. ADITYA
# Local testing: don't send SMS, print the OTP in the server log instead.
# SMS_DRY_RUN=true
# Optional tuning (defaults shown):
# OTP_EXPIRY_MINUTES=5
# OTP_RESEND_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_ATTEMPTS=5
# RESET_TOKEN_MINUTES=10
